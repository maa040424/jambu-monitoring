@startuml Use Case Diagram

skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 10
skinparam padding 4
skinparam actorStyle awesome

skinparam actor {
    BorderColor #37474F
    BackgroundColor #ECEFF1
}

skinparam usecase {
    BorderColor #1565C0
    BackgroundColor #E3F2FD
}

title **Use Case Diagram**\nSistem Monitoring Tanaman Jambu Kristal

actor "Admin (Pengelola)" as admin
actor "Petani (Pengguna)" as petani
actor "Perangkat IoT (ESP32)" as esp32
actor "Telegram (Notifikasi)" as telegram

rectangle "Sistem Monitoring Jambu Kristal" {
    usecase "Autentikasi (Login/Logout)" as UC_Auth
    usecase "Visualisasi Dashboard (Real-time)" as UC_Dash
    usecase "Pemantauan Historis Data Sensor" as UC_Hist
    usecase "Analisis & Prediksi ARIMA" as UC_Forecast
    usecase "Ekspor Laporan PDF" as UC_Export
    usecase "Manajemen Pengguna & Konfigurasi" as UC_Manage
    usecase "Pengiriman Data Sensor" as UC_Ingest
    usecase "Menerima Pesan Notifikasi" as UC_Recv
}

' === Relasi Actor ke Use Case ===
admin --> UC_Auth
admin --> UC_Dash
admin --> UC_Hist
admin --> UC_Forecast
admin --> UC_Export
admin --> UC_Manage

petani --> UC_Auth
petani --> UC_Dash
petani --> UC_Hist
petani --> UC_Forecast
petani --> UC_Export
petani --> UC_Recv

esp32 --> UC_Ingest

' === Relasi Antar Use Case ===
UC_Ingest ..> UC_Recv : <<include>> / trigger

@enduml
