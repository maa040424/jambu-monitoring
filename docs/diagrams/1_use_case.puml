@startuml Use Case Diagram
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam actorStyle awesome

title Use Case Diagram\nSistem Monitoring Tanaman Jambu Kristal

actor "Admin" as admin
actor "Petani" as petani

rectangle "Sistem Monitoring Tanaman Jambu Kristal" {
    usecase "Login" as UC1
    usecase "Lihat Dashboard" as UC2
    usecase "Lihat Data Sensor" as UC3
    usecase "Lihat Prediksi" as UC4
    usecase "Kelola Data Sensor" as UC5
    usecase "Kelola Sistem" as UC6
    usecase "Terima Notifikasi" as UC7
    usecase "Kirim Data Sensor" as UC8
    usecase "Kirim Notifikasi" as UC9
}

actor "Perangkat IoT\n(ESP32)" as iot
actor "Sistem Notifikasi\n(Telegram)" as notif

admin --> UC1
admin --> UC2
admin --> UC3
admin --> UC4
admin --> UC5
admin --> UC6

petani --> UC1
petani --> UC2
petani --> UC3
petani --> UC4
petani --> UC7

iot --> UC8

notif --> UC9

UC8 ..> UC9 : <<include>>

@enduml
