@startuml Arsitektur Sistem

skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 10
skinparam padding 4

skinparam rectangle {
    BorderColor #555555
    BackgroundColor #F5F5F5
    FontStyle bold
}

skinparam node {
    BorderColor #37474F
    BackgroundColor #ECEFF1
}

skinparam database {
    BorderColor #1565C0
    BackgroundColor #E3F2FD
}

skinparam cloud {
    BorderColor #2E7D32
    BackgroundColor #E8F5E9
}

title **Arsitektur Sistem Monitoring & Prediksi Jambu Kristal**

rectangle "**Edge Layer**\n(Kebun Jambu Kristal)" as edge #FFFDE7 {
    rectangle "**ESP32 Microcontroller**\n(Data Collector)" as esp32 #FFF9C4
    rectangle "**Sensor Fisik**\n• Soil Moisture (Kelembapan)\n• DHT22 (Suhu & Kelembaban Udara)\n• LDR (Intensitas Cahaya)" as sensors #FFFFFF
    sensors -right-> esp32 : readings
}

node "**Cloud Server Environment (VPS)**" as server #ECEFF1 {
    rectangle "**Web Gateway (Nginx)**\nReverse Proxy" as nginx #E3F2FD
    rectangle "**Laravel Core Monolith**\n• REST Ingestion Engine\n• Dashboard Web UI\n• Backup & Notification Logic" as laravel #E8F5E9
    database "**MySQL 8.0**\nSensor & User Database" as db #E3F2FD
    rectangle "**Flask Prediction Service**\nARIMA Model Module" as flask #FFF3E0
}

cloud "**Telegram Notification Service**\n(User Alerts & Backup Receiver)" as telegram #E8F5E9

rectangle "**Client Access Layer**" as clients #F5F5F5 {
    rectangle "**Browser (Admin / Petani)**\nInteractive Dashboard & Charts" as web_client #FFFFFF
}

' === Connections ===
esp32 -right-> nginx : **HTTP POST**\n/api/sensor-data\n(X-API-KEY)

web_client -down-> nginx : **HTTP GET / POST**\nAccess Web App & APIs

nginx -down-> laravel : **FastCGI (FPM)**\nport 9000

laravel -right-> db : **PDO MySQL**\nRead & Write
laravel -down-> flask : **HTTP GET /predict**\ninter-service query
laravel -down-> telegram : **HTTPS POST**\nAPI Request

flask -right-> db : **PyMySQL**\nRead training data

@enduml
