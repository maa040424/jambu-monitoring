@startuml Deployment Diagram
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12

title Deployment Diagram\nMonitoring Tanaman Jambu Kristal

node "Perangkat IoT" as iot_node {
    artifact "Mikrokontroler ESP32" as mcu
    component "Sensor Suhu dan\nKelembaban Udara" as s1
    component "Sensor Kelembaban\nTanah" as s2
    component "Sensor Intensitas\nCahaya" as s3
}

node "Server Aplikasi" as app_server {
    artifact "Aplikasi Web" as web_app {
        component "Modul Dashboard" as mod_dash
        component "Modul Penerimaan Data" as mod_recv
        component "Modul Notifikasi" as mod_notif
    }
    artifact "Sistem Prediksi" as ml_app {
        component "Model ARIMA" as mod_arima
    }
}

database "Server Basis Data" as db_server {
    storage "Basis Data Monitoring" as db_name {
        collections "Data Sensor" as tbl_sensor
        collections "Data Pengguna" as tbl_users
    }
}

cloud "Layanan Notifikasi\n(Telegram)" as tele_cloud

node "Klien (Admin)" as client_admin {
    artifact "Peramban Web" as browser_admin
}

node "Klien (Petani)" as client_petani {
    artifact "Peramban Web" as browser_petani
}

' === Koneksi ===
mcu --> mod_recv : Kirim data sensor
browser_admin --> mod_dash : Akses sistem
browser_petani --> mod_dash : Akses sistem
mod_recv --> db_server : Simpan data
mod_dash --> db_server : Ambil data
mod_arima --> db_server : Ambil data historis
mod_notif --> tele_cloud : Kirim notifikasi

@enduml
