@startuml DFD Level 0

skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 10
skinparam padding 4

skinparam rectangle {
    BorderColor #37474F
    BackgroundColor #ECEFF1
    FontStyle bold
}

skinparam usecase {
    BorderColor #1565C0
    BackgroundColor #E3F2FD
    FontStyle bold
}

title **Data Flow Diagram (DFD) Level 0 — Context Diagram**\nSistem Monitoring Tanaman Jambu Kristal

rectangle "**Admin**\n(Pengelola)" as admin #ECEFF1
rectangle "**Petani**\n(Pengguna)" as petani #ECEFF1
rectangle "**Perangkat IoT (ESP32)**\n(Device Layer)" as esp32 #FFF9C4
rectangle "**Telegram Bot API**\n(Notification Gateway)" as telegram #E8F5E9

usecase "**Sistem Monitoring**\n**Jambu Kristal (Laravel + Flask)**" as sistem #E3F2FD

' === Aliran Data ===
esp32 -down-> sistem : **Data Sensor Raw**\n(Suhu, Kelembaban Udara,\nKelembaban Tanah, Cahaya) + API Key

admin -right-> sistem : **Manajemen Data**\n(Kredensial Pengguna,\nRequest Hapus, Config)

sistem -left-> admin : **Informasi Dashboard**\n(Tabel Data, Grafik ARIMA,\nLog Sistem, File Ekspor PDF)

petani -down-> sistem : **Akses Monitoring**\n(Request Dashboard, Request Forecast)

sistem -up-> petani : **Informasi Monitoring**\n(Visualisasi Data, Hasil Prediksi)

sistem -right-> telegram : **Payload Notifikasi**\n(Alert Status Kelembaban,\nDokumen SQL Backup)

@enduml
