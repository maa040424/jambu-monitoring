@startuml Activity Diagram

skinparam backgroundColor white
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 10
skinparam padding 4
skinparam conditionStyle inside

title **Activity Diagram — Alur Kerja Sistem Terintegrasi**

|**Perangkat IoT (ESP32)**|
start
:Baca Data Sensor\n(Suhu, Kelembaban Udara/Tanah, Cahaya);
:Kirim Payload HTTP POST\nke /api/sensor-data\nHeader: X-API-KEY;

|**Reverse Proxy (Nginx)**|
:Terima Request HTTP;
:Lakukan Routing & Pass\nke PHP-FPM (port 9000);

|**Server Aplikasi (Laravel)**|
:Validasi API Key via Middleware;
if (API Key Valid?) then (Ya)
    :Validasi Struktur Data & Payload;
    if (Data Valid?) then (Ya)
        :Tentukan Status Kelembaban\n(Kritis / Perlu / Normal);
        :Simpan Data Sensor & Status\nke Database (MySQL);
        
        :Ambil Status dari Data\nSebelumnya (Source Segregated);
        if (Status Berubah?) then (Ya)
            |**Telegram Gateway**|
            :Kirim Notifikasi Alert\n(Status Lingkungan Berubah);
        else (Tidak)
        endif
        
        |**Server Aplikasi (Laravel)**|
        :Hitung Jumlah Data Real;
        if (Kelipatan 10?) then (Ya)
            :Generate Berkas SQL Backup;
            |**Telegram Gateway**|
            :Kirim File SQL Backup;
        else (Tidak)
        endif
        
        |**Server Aplikasi (Laravel)**|
        :Kembalikan HTTP Respon 201;
    else (Tidak)
        :Kembalikan HTTP Respon 422;
    endif
else (Tidak)
    :Kembalikan HTTP Respon 401;
endif

|**Perangkat IoT (ESP32)**|
:Terima Respon & Masuk Deep Sleep;
stop

@enduml
